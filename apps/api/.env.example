# Servidor & Rede
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
APP_PUBLIC_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Banco de Dados PostgreSQL 17 Puro
DATABASE_URL=postgres://couplerh_app:couplerh_app_password_2026@localhost:5432/couplerh_prod
DATABASE_ADMIN_URL=postgres://postgres:postgres_root_password_2026@localhost:5432/couplerh_prod
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20

# JWT & Sessao
JWT_ACCESS_SECRET=couplerh_jwt_access_secret_super_secure_key_change_in_production_min_64_chars
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=7

# Criptografia & Seguranca (32 bytes em hex = 64 chars)
DATA_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
STORAGE_HMAC_SECRET=couplerh_storage_hmac_secret_super_secure_key_change_in_production

# Storage Local
STORAGE_BASE_PATH=./storage_data

# SMTP Mailer
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=test_user
SMTP_PASS=test_pass
SMTP_FROM_NAME=CoupleRH Enterprise
SMTP_FROM_EMAIL=nao-responda@couplerh.com.br

# eSocial
ESOCIAL_ENVIRONMENT=HOMOLOGATION
ESOCIAL_LAYOUT_VERSION=S-1.3
CERTIFICATE_MASTER_KEY=couplerh_cert_master_key_v2_enterprise_32chars_min_2026
ESOCIAL_WS_HOMOLOG_SEND_URL=https://webservices.producaorestrita.esocial.gov.br/servicos/empregador/enviarloteeventos/WsEnviarLoteEventos.svc
ESOCIAL_WS_HOMOLOG_QUERY_URL=https://webservices.producaorestrita.esocial.gov.br/servicos/empregador/consultarloteeventos/WsConsultarLoteEventos.svc
ESOCIAL_WS_PROD_SEND_URL=https://webservices.envio.esocial.gov.br/servicos/empregador/enviarloteeventos/WsEnviarLoteEventos.svc
ESOCIAL_WS_PROD_QUERY_URL=https://webservices.consulta.esocial.gov.br/servicos/empregador/consultarloteeventos/WsConsultarLoteEventos.svc
ESOCIAL_MTLS_REJECT_UNAUTHORIZED=true