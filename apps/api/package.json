{
  "name": "@couplerh/api",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server.js",
    "migrate": "tsx db/migrate.ts",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@couplerh/payroll-core": "*",
    "fastify": "^5.2.0",
